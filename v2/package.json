{
  "name": "slim-cc-v2",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json && npm run test:frontend",
    "test:frontend": "vitest run",
    "test:integration": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:integration && npm run test:e2e",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "typescript": "^5.0.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
