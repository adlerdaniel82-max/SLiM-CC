{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLiM-CC v2",
  "version": "2.1.0",
  "identifier": "de.schnueddels.slim-cc.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SLiM-CC v2 — Skyrim Linux Mod ControlCenter",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/slim-cc/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nxm"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "targets": [
      "rpm",
      "appimage"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "fuse-overlayfs",
          "fuse3"
        ]
      }
    },
    "icon": [
      "icons/128x128.png"
    ]
  }
}
